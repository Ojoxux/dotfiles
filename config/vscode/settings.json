{
  "dart.flutterSdkPath": "/Users/Ojoxux/FlutterSDK/flutter",
  "security.workspace.trust.untrustedFiles": "open",
  "git.autofetch": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "Source Code Pro",
  "editor.fontLigatures": true,
  "workbench.colorTheme": "Aura Dark",
  "terminal.external.osxExec": "iTerm.app",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
  },
  "workbench.iconTheme": "vscode-icons",
  "redhat.telemetry.enabled": true,
  "go.toolsManagement.autoUpdate": true,
  "git.openRepositoryInParentFolders": "never",
  "git.suggestSmartCommit": false,
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "diffEditor.ignoreTrimWhitespace": false,
  "git.confirmSync": false,
  "settingsSync.ignoredExtensions": [],
  "editor.codeActionsOnSave": {},
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
  },
  "vsicons.dontShowNewVersionMessage": true,
  "docker.extension.enableComposeLanguageServer": false,
  "editor.fontSize": 13,
  "claudeCode.preferredLocation": "panel",
  "techtrain-railway.optOutTelemetry": true,
  "editor.quickSuggestions": false,
  "workbench.sideBar.location": "right",
  "editor.inlineSuggest.enabled": false,
  "editor.inlayHints.fontFamily": "Source Code Pro",
  "accessibility.dimUnfocused.opacity": 0.5,
  "haskell.manageHLS": "PATH",
  "haskell.serverExecutablePath": "/etc/profiles/per-user/Ojoxux/bin/haskell-language-server-wrapper",
